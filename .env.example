# Copy to .env and fill in.

# MongoDB (Atlas or local). The path segment is the database name.
DATABASE_URL="mongodb+srv://USER:PASS@CLUSTER.mongodb.net/khata?retryWrites=true&w=majority"

PORT=4000
API_BASE=api
NODE_ENV=development

# Auth secrets — change in production.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Google OAuth (optional). If unset, /auth/oauth/google runs in trust-idToken dev mode.
GOOGLE_CLIENT_ID=""

# Seed admin account.
ADMIN_EMAIL="admin@khata.app"
ADMIN_PASSWORD="admin12345"

# OTP delivery. OTP_DEV_MODE=true returns the code in API responses + logs it.
# false = send real email, code not returned.
OTP_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# AI assistant. AI_PROVIDER = rules | gemini
# gemini uses Google Gemini Flash (free tier: https://aistudio.google.com/apikey)
# and falls back to rules automatically on any error or missing key.
AI_PROVIDER=rules
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-flash-lite-latest
AI_RATE_PER_MIN=10
